ll mx-auto flex items-center justify-center text-red-600 mb-1\">\n          <svg className=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path\n              strokeLinecap=\"round\"\n              strokeLinejoin=\"round\"\n              strokeWidth=\"2\"\n              d=\"M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z\"\n            ></path>\n          </svg>\n        </div>\n\n        <div>\n          <h2 className=\"text-lg font-bold text-slate-800\" id=\"access-denied-title\">\n            Access Restricted\n          </h2>\n          <p className=\"text-xs text-slate-500 mt-1\">\n            You do not have permission to view <code className=\"bg-slate-100 px-1.5 py-0.5 rounded text-[11px] font-mono text-slate-700\">{attemptedPath}</code>.\n          </p>\n        </div>\n\n        {currentUser && (\n          <div className=\"text-xs text-slate-600 bg-slate-50 p-3.5 rounded-lg border border-slate-200 text-left space-y-1.5\">\n            <div>\n              <span className=\"font-semibold text-slate-700\">Account:</span> {currentUser.name}\n            </div>\n            <div>\n              <span className=\"font-semibold text-slate-700\">Role:</span>{\' \'}\n              <span className=\"capitalize font-bold text-slate-900\">{currentUser.role}</span>\n            </div>\n            <div>\n              <span className=\"font-semibold text-slate-700\">Required Role:</span>{\' \'}\n              <span className=\"capitalize font-bold text-indigo-700\">\n                {attemptedPath.replace(\'/\', \'\')}\n              </span>\n            </div>\n          </div>\n        )}\n\n        <div className=\"flex flex-col sm:flex-row items-center justify-center gap-2 pt-2\">\n          {currentUser ? (\n            <button\n              id=\"return-to-authorized-panel-button\"\n              onClick={onGoToRolePanel}\n              className=\"w-full sm:w-auto bg-slate-800 hover:bg-slate-700 text-white font-semibold py-2 px-4 rounded-md text-xs cursor-pointer shadow-xs transition-colors\"\n            >\n              Go to my /{currentUser.role} panel\n            </button>\n          ) : (\n            <button\n              id=\"login-redirect-button\"\n              onClick={onLogout}\n              className=\"w-full sm:w-auto bg-slate-800 hover:bg-slate-700 text-white font-semibold py-2 px-4 rounded-md text-xs cursor-pointer shadow-xs transition-colors\"\n            >\n              Sign in\n            </button>\n          )}\n\n          {currentUser && (\n            <button\n              id=\"access-denied-logout-button\"\n              onClick={onLogout}\n              className=\"w-full sm:w-auto border border-slate-200 hover:bg-slate-50 text-slate-700 font-semibold py-2 px-4 rounded-md text-xs cursor-pointer shadow-xs transition-colors\"\n            >\n              Sign out\n            </button>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\nThe following action was requested:\nCreate file /src/App.tsx with overwrite=trueThe action produced the following result:\nSuccessfully created file /src/App.tsx with content:\nimport { useState, useEffect } from \'react\';\nimport { User, Task } from \'./types\';\nimport { INITIAL_USERS, INITIAL_TASKS } from \'./mockData\';\nimport { Header } from \'./components/Header\';\nimport { LoginPage } from \'./components/LoginPage\';\nimport { AdminPanel } from \'./components/AdminPanel\';\nimport { ManagerPanel } from \'./components/ManagerPanel\';\nimport { EmployeePanel } from \'./components/EmployeePanel\';\nimport { AccessDenied } from \'./components/AccessDenied\';\n\nexport default function App() {\n  const [users, setUsers] = useState<User[]>(INITIAL_USERS);\n  const [tasks] = useState<Task[]>(INITIAL_TASKS);\n  const [currentUser, setCurrentUser] = useState<User | null>(null);\n  const [currentPath, setCurrentPath] = useState<string>(() => {\n    const path = window.location.pathname;\n    if (path === \'/admin\' || path === \'/manager\' || path === \'/employee\' || path === \'/login\') {\n      return path;\n    }\n    return \'/login\';\n  });\n\n  // Sync with browser history\n  useEffect(() => {\n    const handlePopState = () => {\n      const path = window.location.pathname;\n      if (path === \'/admin\' || path === \'/manager\' || path === \'/employee\' || path === \'/login\') {\n        setCurrentPath(path);\n      } else {\n        setCurrentPath(\'/login\');\n      }\n    };\n\n    window.addEventListener(\'popstate\', handlePopState);\n    return () => window.removeEventListener(\'popstate\', handlePopState);\n  }, []);\n\n  const navigate = (path: string) => {\n    if (window.location.pathname !== path) {\n      window.history.pushState({}, \'\', path);\n    }\n    setCurrentPath(path);\n  };\n\n  const handleLogin = (user: User) => {\n    setCurrentUser(user);\n    const targetRoute = `/${user.role}`;\n    navigate(targetRoute);\n  };\n\n  const handleLogout = () => {\n    setCurrentUser(null);\n    navigate(\'/login\');\n  };\n\n  const handleAddUser = (newUserData: Omit<User, \'id\'>) => {\n    const newUser: User = {\n      ...newUserData,\n      id: `u-${Date.now()}`,\n    };\n    setUsers((prev) => [...prev, newUser]);\n  };\n\n  // Render view based on authentication and route\n  const renderContent = () => {\n    // 1. Not logged in\n    if (!currentUser) {\n      if (currentPath === \'/login\' || currentPath === \'/\') {\n        return <LoginPage users={users} onLogin={handleLogin} />;\n      }\n      // Accessing protected route while logged out\n      return (\n        <AccessDenied\n          currentUser={null}\n          attemptedPath={currentPath}\n          onGoToRolePanel={() => navigate(\'/login\')}\n          onLogout={handleLogout}\n        />\n      );\n    }\n\n    // 2. Logged in, navigating to /login\n    if (currentPath === \'/login\' || currentPath === \'/\') {\n      return (\n        <div className=\"py-16 text-center text-xs text-slate-400 font-medium\">\n          Redirecting to /{currentUser.role}...\n        </div>\n      );\n    }\n\n    // 3. Admin Route\n    if (currentPath === \'/admin\') {\n      if (currentUser.role === \'admin\') {\n        return <AdminPanel users={users} onAddUser={handleAddUser} />;\n      }\n      return (\n        <AccessDenied\n          currentUser={currentUser}\n          attemptedPath={currentPath}\n          onGoToRolePanel={() => navigate(`/${currentUser.role}`)}\n          onLogout={handleLogout}\n        />\n      );\n    }\n\n    // 4. Manager Route\n    if (currentPath === \'/manager\') {\n      if (currentUser.role === \'manager\') {\n        return <ManagerPanel tasks={tasks} />;\n      }\n      return (\n        <AccessDenied\n          currentUser={currentUser}\n          attemptedPath={currentPath}\n          onGoToRolePanel={() => navigate(`/${currentUser.role}`)}\n          onLogout={handleLogout}\n        />\n      );\n    }\n\n    // 5. Employee Route\n    if (currentPath === \'/employee\') {\n      if (currentUser.role === \'employee\') {\n        return <EmployeePanel currentUser={currentUser} tasks={tasks} />;\n      }\n      return (\n        <AccessDenied\n          currentUser={currentUser}\n          attemptedPath={currentPath}\n          onGoToRolePanel={() => navigate(`/${currentUser.role}`)}\n          onLogout={handleLogout}\n        />\n      );\n    }\n\n    // Unknown route\n    return (\n      <div className=\"max-w-md mx-auto py-16 px-4 text-center\">\n        <h2 className=\"text-base font-bold text-slate-800 mb-1\">Page Not Found</h2>\n        <p className=\"text-xs text-slate-500 mb-4\">The route {currentPath} does not exist.</p>\n        <button\n          onClick={() => navigate(currentUser ? `/${currentUser.role}` : \'/login\')}\n          className=\"text-xs font-semibold bg-slate-800 hover:bg-slate-700 text-white px-3.5 py-2 rounded-md shadow-xs cursor-pointer transition-colors\"\n        >\n          Return to Workspace\n        </button>\n      </div>\n    );\n  };\n\n  // If logged in and on login route, handle automatic redirection\n  useEffect(() => {\n    if (currentUser && (currentPath === \'/login\' || currentPath === \'/\')) {\n      navigate(`/${currentUser.role}`);\n    }\n  }, [currentUser, currentPath]);\n\n  return (\n    <div className=\"min-h-screen bg-slate-50 text-slate-900 flex flex-col font-sans antialiased\">\n      <Header\n        currentUser={currentUser}\n        currentPath={currentPath}\n        onNavigate={navigate}\n        onLogout={handleLogout}\n      />\n\n      <main className=\"flex-1 pb-16\">{renderContent()}</main>\n\n      <footer className=\"py-4 border-t border-slate-200 bg-white text-center text-xs text-slate-400\">\n        <div className=\"max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-2\">\n          <span>WorkSphere &bull; Enterprise Task Assignment Platform</span>\n          <span className=\"text-[11px] text-slate-400\">In-Memory Mock Environment</span>\n        </div>\n      </footer>\n    </div>\n  );\n}\nThe following action was requested:\nRunning linter...The action produced the following result:\nLinting completed successfully\nOutput:\n\n> react-example@0.0.0 lint\n> tsc --noEmit\n\nThe following action was requested:\nBuilding applet...The action produced the following result:\nBuild succeeded - the applet is compiled"
