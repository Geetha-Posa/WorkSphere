rounded-lg cursor-pointer flex items-center justify-between text-xs transition-colors group\"\n            >\n              <div className=\"flex items-center gap-2\">\n                <span className=\"px-1.5 py-0.5 rounded bg-slate-100 text-slate-700 text-[10px] font-bold border border-slate-200 uppercase\">\n                  Employee\n                </span>\n                <span className=\"font-medium text-slate-700 group-hover:text-indigo-900\">\n                  alex.emp@test.com (Alex R.)\n                </span>\n              </div>\n              <span className=\"text-slate-400 font-mono text-[11px]\">password123</span>\n            </div>\n\n            <div\n              id=\"demo-account-employee-2\"\n              onClick={() => handleFillCredentials(\'jordan.emp@test.com\', \'password123\')}\n              className=\"p-2.5 bg-slate-50 hover:bg-indigo-50/50 border border-slate-200 hover:border-indigo-200 rounded-lg cursor-pointer flex items-center justify-between text-xs transition-colors group\"\n            >\n              <div className=\"flex items-center gap-2\">\n                <span className=\"px-1.5 py-0.5 rounded bg-slate-100 text-slate-700 text-[10px] font-bold border border-slate-200 uppercase\">\n                  Employee\n                </span>\n                <span className=\"font-medium text-slate-700 group-hover:text-indigo-900\">\n                  jordan.emp@test.com (Jordan T.)\n                </span>\n              </div>\n              <span className=\"text-slate-400 font-mono text-[11px]\">password123</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\nThe following action was requested:\nCreate file /src/components/AdminPanel.tsx with overwrite=trueThe action produced the following result:\nSuccessfully created file /src/components/AdminPanel.tsx with content:\nimport React, { useState } from \'react\';\nimport { User, UserRole } from \'../types\';\n\ninterface AdminPanelProps {\n  users: User[];\n  onAddUser: (newUser: Omit<User, \'id\'>) => void;\n}\n\nexport const AdminPanel: React.FC<AdminPanelProps> = ({ users, onAddUser }) => {\n  const [name, setName] = useState(\'\');\n  const [email, setEmail] = useState(\'\');\n  const [password, setPassword] = useState(\'\');\n  const [role, setRole] = useState<\'manager\' | \'employee\'>(\'employee\');\n  const [team, setTeam] = useState(\'\');\n  const [successNotice, setSuccessNotice] = useState(\'\');\n  const [errorNotice, setErrorNotice] = useState(\'\');\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    setSuccessNotice(\'\');\n    setErrorNotice(\'\');\n\n    const trimmedName = name.trim();\n    const trimmedEmail = email.trim();\n    const trimmedTeam = team.trim();\n\n    if (!trimmedName || !trimmedEmail || !password || !trimmedTeam) {\n      setErrorNotice(\'All fields are required.\');\n      return;\n    }\n\n    if (users.some((u) => u.email.toLowerCase() === trimmedEmail.toLowerCase())) {\n      setErrorNotice(\'A user with this email already exists.\');\n      return;\n    }\n\n    onAddUser({\n      name: trimmedName,\n      email: trimmedEmail,\n      password: password,\n      role: role as UserRole,\n      team: trimmedTeam,\n    });\n\n    setSuccessNotice(`User \"${trimmedName}\" created successfully.`);\n    setName(\'\');\n    setEmail(\'\');\n    setPassword(\'\');\n    setRole(\'employee\');\n    setTeam(\'\');\n  };\n\n  return (\n    <div id=\"admin-panel\" className=\"max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8 space-y-8\">\n      {/* Header section */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 border-b border-slate-200 pb-5\">\n        <div>\n          <h1 id=\"admin-title\" className=\"text-xl font-bold tracking-tight text-slate-800\">\n            Admin Panel\n          </h1>\n          <p className=\"text-xs text-slate-500 mt-0.5\">\n            Manage organization members, assign role permissions, and provision accounts\n          </p>\n        </div>\n        <div className=\"flex items-center gap-2\">\n          <span className=\"px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200 uppercase tracking-wider\">\n            Admin Access Level\n          </span>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\">\n        {/* Create New User Section (Left Column) */}\n        <section\n          id=\"admin-create-user-section\"\n          className=\"lg:col-span-4 bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden\"\n        >\n          <div className=\"p-5 border-b border-slate-100 bg-slate-50/50\">\n            <h2 id=\"create-user-heading\" className=\"text-xs font-bold text-slate-500 uppercase tracking-widest flex items-center gap-2\">\n              <svg\n                className=\"w-4 h-4 text-slate-500\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                viewBox=\"0 0 24 24\"\n              >\n                <path\n                  strokeLinecap=\"round\"\n                  strokeLinejoin=\"round\"\n                  strokeWidth=\"2\"\n                  d=\"M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z\"\n                ></path>\n              </svg>\n              Create New User\n            </h2>\n          </div>\n\n          <div className=\"p-6\">\n            {successNotice && (\n              <div\n                id=\"admin-success-notice\"\n                className=\"mb-4 p-3 bg-emerald-50 border border-emerald-200 text-emerald-700 text-xs font-medium rounded-lg flex items-center gap-2\"\n              >\n                <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0\"></span>\n                <span>{successNotice}</span>\n              </div>\n            )}\n\n            {errorNotice && (\n              <div\n                id=\"admin-error-notice\"\n                className=\"mb-4 p-3 bg-red-50 border border-red-200 text-red-700 text-xs font-medium rounded-lg flex items-center gap-2\"\n              >\n                <span className=\"w-1.5 h-1.5 rounded-full bg-red-500 shrink-0\"></span>\n                <span>{errorNotice}</span>\n              </div>\n            )}\n\n            <form id=\"create-user-form\" onSubmit={handleSubmit} className=\"space-y-4\">\n              <div>\n                <label\n                  htmlFor=\"user-name-input\"\n                  className=\"block text-xs font-bold text-slate-500 mb-1\"\n                >\n                  Full Name\n                </label>\n                <input\n                  id=\"user-name-input\"\n                  type=\"text\"\n                  required\n                  value={name}\n                  onChange={(e) => setName(e.target.value)}\n                  placeholder=\"e.g. Alex Rivera\"\n                  className=\"w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-md text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:bg-white focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500 transition-colors\"\n                />\n              </div>\n\n              <div>\n                <label\n                  htmlFor=\"user-email-input\"\n                  className=\"block text-xs font-bold text-slate-500 mb-1\"\n                >\n                  Email Address\n                </label>\n                <input\n                  id=\"user-email-input\"\n                  type=\"email\"\n                  required\n                  value={email}\n                  onChange={(e) => setEmail(e.target.value)}\n                  placeholder=\"alex@worksphere.com\"\n                  className=\"w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-md text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:bg-white focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500 transition-colors\"\n                />\n              </div>\n\n              <div>\n                <label\n                  htmlFor=\"user-password-input\"\n                  className=\"block text-xs font-bold text-slate-500 mb-1\"\n                >\n                  Password\n                </label>\n                <input\n                  id=\"user-password-input\"\n                  type=\"password\"\n                  required\n                  value={password}\n                  onChange={(e) => setPassword(e.target.value)}\n                  placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\"\n                  className=\"w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-md text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:bg-white focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500 transition-colors\"\n                />\n              </div>\n\n              <div className=\"grid grid-cols-2 gap-3\">\n                <div>\n                  <label\n                    htmlFor=\"user-role-select\"\n                    className=\"block text-xs font-bold text-slate-500 mb-1\"\n                  >\n                    Role\n                  </label>\n                  <select\n                    id=\"user-role-select\"\n                    value={role}\n                    onChange={(e) => setRole(e.target.value as \'manager\' | \'employee\')}\n                    className=\"w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-md text-sm text-slate-800 focus:outline-none focus:bg-white focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500 transition-colors\"\n                  >\n                    <option value=\"employee\">Employee</option>\n                    <option value=\"manager\">Manager</option>\n                  </select>\n                </div>\n\n                <div>\n                  <label\n                    htmlFor=\"user-team-input\"\n                    className=\"block text-xs font-bold text-slate-500 mb-1\"\n                  >\n                    Team\n                  </label>\n                  <input\n                    id=\"user-team-input\"\n                    type=\"text\"\n                    required\n                    value={team}\n                    onChange={(e) => setTeam(e.target.value)}\n                    placeholder=\"Engineering\"\n                    className=\"w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-md text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:bg-white focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500 transition-colors\"\n                  />\n                </div>\n              </div>\n\n              <button\n                id=\"create-user-submit-button\"\n                type=\"submit\"\n                className=\"w-full py-2.5 bg-slate-800 hover:bg-slate-700 text-white rounded-md text-sm font-semibold shadow-xs cursor-pointer transition-colors mt-2\"\n              >\n                Register Account\n              </button>\n            </form>\n          </div>\n        </section>\n\n        {/* Existing Users Table (Right Column) */}\n        <section\n          id=\"admin-user-list-section\"\n          className=\"lg:col-span-8 bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden flex flex-col\"\n        >\n          <div className=\"p-5 border-b border-slate-100 flex justify-between items-center bg-slate-50/50\">\n            <div>\n              <h2 id=\"existing-users-heading\" className=\"text-sm font-bold text-slate-700\">\n                Global Directory\n              </h2>\n              <p className=\"text-xs text-slate-400\">All registered system accounts</p>\n            </div>\n            <span\n              id=\"user-count-badge\"\n              className=\"px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-600 text-xs font-semibold border border-slate-200 font-mono\"\n            >\n              {users.length} Total Users\n            </span>\n          </div>\n\n          <div className=\"overflow-x-auto\">\n            <table id=\"users-table\" className=\"w-full text-left border-collapse\">\n              <thead>\n                <tr className=\"bg-slate-50/70 text-[10px] uppercase tracking-wider font-bold text-slate-400 border-b border-slate-100\">\n                  <th className=\"px-6 py-3\">Name</th>\n                  <th className=\"px-6 py-3\">Email</th>\n                  <th className=\"px-6 py-3\">Role</th>\n                  <th className=\"px-6 py-3 text-right\">Team</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-slate-100 text-sm\">\n                {users.map((u) => (\n                  <tr\n                    key={u.id}\n                    id={`user-row-${u.id}`}\n                    className=\"hover:bg-slate-50/60 transition-colors\"\n                  >\n                    <td className=\"px-6 py-4 font-semibold text-slate-700\">\n                      {u.name}\n                    </td>\n                    <td className=\"px-6 py-4 text-slate-500 font-mono text-xs\">\n                      {u.email}\n                    </td>\n                    <td className=\"px-6 py-4\">\n                      {u.role === \'admin\' && (\n                        <span className=\"px-2 py-0.5 rounded bg-amber-50 text-amber-700 text-[10px] font-bold border border-amber-100 uppercase tracking-wide\">\n                          Admin\n                        </span>\n                      )}\n                      {u.role === \'manager\' && (\n                        <span className=\"px-2 py-0.5 rounded bg-blue-50 text-blue-700 text-[10px] font-bold border border-blue-100 uppercase tracking-wide\">\n                          Manager\n                        </span>\n              