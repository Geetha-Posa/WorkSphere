h-6 text-indigo-600 ${isSyncing ? \'animate-spin\' : \'\'}`}\n                  fill=\"none\"\n                  stroke=\"currentColor\"\n                  viewBox=\"0 0 24 24\"\n                >\n                  <path\n                    strokeLinecap=\"round\"\n                    strokeLinejoin=\"round\"\n                    strokeWidth=\"2\"\n                    d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15\"\n                  ></path>\n                </svg>\n              </div>\n              <p className=\"text-xs text-slate-600 mb-4 max-w-xs\">\n                Synchronize external workspace documents with current team task queues.\n              </p>\n              <button\n                id=\"sync-now-button\"\n                type=\"button\"\n                onClick={handleSyncNow}\n                disabled={isSyncing}\n                className=\"w-full py-2.5 bg-white hover:bg-slate-50 active:bg-slate-100 border border-slate-200 rounded-md shadow-xs text-xs font-bold text-slate-700 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed transition-colors\"\n              >\n                {isSyncing ? \'Checking for new documents...\' : \'Sync Documents Now\'}\n              </button>\n\n              {syncStatus && (\n                <div\n                  id=\"sync-status-message\"\n                  className=\"mt-3.5 w-full p-2.5 bg-indigo-50 border border-indigo-100 text-indigo-800 text-xs font-medium rounded-md text-center\"\n                >\n                  {syncStatus}\n                </div>\n              )}\n            </div>\n          </div>\n        </section>\n\n        {/* Active Tasks Queue Table (Right Column) */}\n        <section\n          id=\"manager-tasks-section\"\n          className=\"lg:col-span-8 bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden flex flex-col\"\n        >\n          <div className=\"p-5 border-b border-