on members, assign role permissions, and provision accounts\n          </p>\n        </div>\n        <div className=\"flex items-center gap-2\">\n          <span className=\"px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200 uppercase tracking-wider\">\n            Admin Access Level\n          </span>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\">\n        {/* Create New User Section (Left Column) */}\n        <section\n          id=\"admin-create-user-section\"\n          className=\"lg:col-span-4 bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden\"\n        >\n          <div className=\"p-5 border-b border-slate-100 bg-slate-50/50\">\n            <h2 id=\"create-user-heading\" className=\"text-xs font-bold text-slate-500 uppercase tracking-widest flex items-center gap-2\">\n              <svg\n                className=\"w-4 h-4 text-slate-500\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                viewBox=\"0 0 24 24\"\n              >\n                <path\n                  strokeLinecap=\"round\"\n                  strokeLinejoin=\"round\"\n                  strokeWidth=\"2\"\n                  d=\"M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z\"\n                ></path>\n              </svg>\n              Create New User\n            </h2>\n          </div>\n\n          <div className=\"p-6\">\n            {successNotice && (\n              <div\n                id=\"admin-success-notice\"\n                className=\"mb-4 p-3 bg-emerald-50 border border-emerald-200 text-emerald-700 text-xs font-medium rounded-lg flex items-center gap-2\"\n              >\n                <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0\"></span>\n                <span>{successNotice}</span>\n              </div>\n            )}\n\n            {errorNotice